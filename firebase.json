{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "www",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/criar-pagamento",
        "function": { "functionId": "criarPagamento", "region": "southamerica-east1" }
      },
      {
        "source": "/api/webhook",
        "function": { "functionId": "mercadoPagoWebhook", "region": "southamerica-east1" }
      },
      {
        "source": "/api/licencas",
        "function": { "functionId": "listarLicencas", "region": "southamerica-east1" }
      },
      {
        "source": "/api/licenca-status",
        "function": { "functionId": "licencaStatus", "region": "southamerica-east1" }
      },
      {
        "source": "/api/extrair-comprovante",
        "function": { "functionId": "extrairComprovante", "region": "southamerica-east1" }
      }
    ]
  }
}